{
  "name": "libgen-calibre-store-plugin",
  "$schema": "./.nx/installation/node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m compileall -q -f __init__.py libgen_plugin.py"
      },
      "cache": true,
      "inputs": ["{projectRoot}/**/*.py"],
      "outputs": ["{projectRoot}/__pycache__"]
    }
  }
}
